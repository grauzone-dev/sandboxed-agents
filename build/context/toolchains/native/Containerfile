ARG BASE_IMAGE
FROM ${BASE_IMAGE}

COPY native/smoke.sh /usr/local/share/sandboxed-agents/smoke/native.sh
COPY native/install.sh /tmp/install-native.sh
COPY record-versions.sh /tmp/record-versions.sh
RUN sh /tmp/install-native.sh \
    && sh /tmp/record-versions.sh \
    && rm /tmp/install-native.sh /tmp/record-versions.sh
